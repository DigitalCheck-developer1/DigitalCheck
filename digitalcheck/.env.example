# === Database (Fase 2 — persistenza) ===
DATABASE_URL=

# === AI provider (server-side only, mai esposta al client) ===
# Usata da src/lib/ai/content-analyzer.ts per generare l'interpretazione
# testuale dei dati tecnici. Qualsiasi provider compatibile con un endpoint
# chat/completions puo' essere collegato qui: e' sufficiente adattare
# la funzione callAiProvider().
AI_API_KEY=
AI_MODEL=

# === PageSpeed / Core Web Vitals (opzionale, Fase 1 avanzata) ===
# Se assente, il modulo performance dichiara i dati come
# "non verificabile automaticamente" invece di inventarli.
PAGESPEED_API_KEY=

# === Auth ===
# Segreto usato per firmare i cookie di sessione (JWT). Genera un valore
# lungo e casuale, es: openssl rand -base64 32
AUTH_SECRET=

# === Stripe ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID del piano Pro creato nella dashboard Stripe (es. price_...)
STRIPE_PRICE_ID_PRO=

# === Monitoraggio periodico ===
# Segreto condiviso richiesto nell'header Authorization dal chiamante del
# cron (Vercel Cron o uno scheduler esterno). Senza corrispondenza esatta
# l'endpoint rifiuta la richiesta. Vedi vercel.json e README, sez. 16.
CRON_SECRET=

# === Email transazionale (verifica account, reset password) ===
# Adapter implementato per Resend; senza chiave, il sistema NON invia
# email: logga il contenuto lato server e, solo fuori produzione, lo
# restituisce nella risposta API per permettere il test in locale.
RESEND_API_KEY=
EMAIL_FROM=DigitalCheck <no-reply@digitalcheck.app>

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Crawler / sicurezza ===
# Numero massimo di pagine per scansione (piano Free). Vedi ssrf-guard.ts
# e crawler.ts: questo valore non e' hardcoded nella logica.
SCAN_MAX_PAGES_FREE=5
SCAN_MAX_PAGES_PRO=20
SCAN_TIMEOUT_MS=8000
SCAN_MAX_RESPONSE_BYTES=3000000
